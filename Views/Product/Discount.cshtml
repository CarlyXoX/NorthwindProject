@model IEnumerable<Discount>

<ul class="list-group">
@foreach (Discount discount in Model)
{
    <li class="list-group-item">
        <strong>@discount.Title</strong> - @discount.Description
        <br />
        Expires: @discount.EndTime.ToString("MM/dd/yyyy")
        <br />
        Code: @discount.Code

        @if (User.IsInRole("northwind-employee"))
        {
            <div class="mt-2">
                <button class="btn btn-sm btn-outline-primary" 
                        data-bs-toggle="modal" 
                        data-bs-target="#editDiscountModal-@discount.DiscountId">
                    Edit
                </button>

                <a asp-action="DeleteDiscount" asp-route-id="@discount.DiscountId" class="btn btn-sm btn-danger">
                    Delete
                </a>

            </div>

            <div class="modal fade" id="editDiscountModal-@discount.DiscountId" tabindex="-1" aria-labelledby="editDiscountLabel-@discount.DiscountId" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="editDiscountLabel-@discount.DiscountId">Edit Discount</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <form asp-action="EditDiscount" method="post">
                        <input type="hidden" name="DiscountId" value="@discount.DiscountId" />

                        <div class="modal-body">

                            <div class="mb-3">
                                <label class="form-label">Discount Title</label>
                                <input name="Title" class="form-control" value="@discount.Title" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea name="Description" class="form-control" rows="3" required>@discount.Description</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Product</label>
                                <select name="ProductId" class="form-select" required>
                                    @foreach (var p in ViewBag.Products)
                                    {
                                        <option value="@p.ProductId" selected="@(p.ProductId == discount.ProductId ? "selected" : null)">
                                            @p.ProductName
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">End Date</label>
                                <input type="date" name="EndTime" class="form-control" value="@discount.EndTime.ToString("yyyy-MM-dd")" required />
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Save Changes</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
        }
    </li>
}
</ul>

//Add discount button, only visible to employees
@if (User.IsInRole("northwind-employee"))
{
    <button class="btn btn-success my-3" data-bs-toggle="modal" data-bs-target="#addDiscountModal">
        Add Discount
    </button>
    
    <div class="modal fade" id="addDiscountModal" tabindex="-1" aria-labelledby="addDiscountLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="addDiscountLabel">Create New Discount</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form asp-action="AddDiscount" method="post">

                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">Discount Title</label>
                            <input name="Title" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control" rows="3" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Product</label>
                            <select name="ProductId" class="form-select" required>
                                @foreach (var p in ViewBag.Products)
                                {
                                    <option value="@p.ProductId">@p.ProductName</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">End Date</label>
                            <input type="date" name="EndTime" class="form-control" required />
                        </div>

                    </div> <!-- end modal-body -->

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Create Discount</button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    
}
