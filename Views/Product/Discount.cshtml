@model IEnumerable<Discount>

<h2 class="mt-3"><i class="fas fa-list-ul"></i>Discounts</h2>
<!-- Add discount button, only visible to employees -->
@if (User.IsInRole(role: "northwind-employee"))
{
    <button type="button" class="btn btn-tertiary"><a asp-controller="Product" asp-action="AddDiscount">Add
            Discount</a></button>
}

<ul class="list-group">
    @foreach (Discount discount in Model)
    {
        <li class="list-group-item">
            <strong>@discount.Title</strong> - @discount.Description
            <br />
            Expires: @discount.EndTime.ToString("MM/dd/yyyy")
            <br />
            Code: @discount.Code

            @if (User.IsInRole("northwind-employee"))
            {
                <div class="mt-2">
                    <a asp-action="EditDiscount" asp-route-id="@discount.DiscountId">Edit</a>
                    |
                    <a asp-action="DeleteDiscount" asp-route-id="@discount.DiscountId">Delete</a>
                </div>
            }
        </li>
    }
</ul>

<!-- Add discount button, only visible to employees -->
@if (User.IsInRole(role: "northwind-employee"))
{
    <button type="button" class="btn btn-tertiary"><a asp-controller="Product" asp-action="AddDiscount">Add
            Discount</a></button>
}