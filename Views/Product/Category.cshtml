@model IEnumerable<Category>

<h2 class="mt-3"><i class="fas fa-list-ul"></i> Product Categories</h2>
<ul class="list-group">
    @foreach (Category c in Model)
    {
        <li class="list-group-item list-group-item-action"><a asp-controller="Product" asp-action="Index"
                asp-route-id="@c.CategoryId">@c.CategoryName - @c.Description</a></li>
    }
</ul>