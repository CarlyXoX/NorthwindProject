@model IEnumerable<Discount>

<div class="p-4 m-2 mt-4 bg-body-tertiary rounded-3 border">
    <h1 class="display-4 fw-bold">
        Northwind
    </h1>
    <p class="fs-4">
        We have the best prices and selection of high quality foods &amp; beverages on the planet! Check out our featured discounts below.
    </p>
    <hr class="my-4">
    <p class="fs-5">For exceptional international cuisine, look no further.</p>
    <a class="btn btn-outline-primary btn-lg" href="#" role="button"><i class="bi bi-cart"></i> Order Now</a>
</div>
<div class="p-2 m-2 row row-cols-1 row-cols-lg-3 featured" id="discount-row">
    @foreach (Discount d in Model)
    {
        <div class="col discounts px-2 py-4">
            <h4>@d.Title</h4>
            <div class="mb-4">
                @d.Description
            </div>
            <i>Discount expires: @d.EndTime.ToString("MM/dd/yyyy")</i><br />
            <a href="#" data-code="@d.Code" data-title="@d.Title" data-product="@d.Product.ProductName" class="discount"><i class="far fa-hand-point-right"></i> Discount Code</a>

            //Edit and Delete discount visble to employees for each discount
            @if (User.IsInRole("northwind-employee"))
            {
                <a asp-action="EditDiscount" asp-route-id="@d.DiscountId">Edit</a>
                <span> | </span>
                <a asp-action="DeleteDiscount" asp-route-id="@d.DiscountId">Delete</a>
            }
        </div>
    }
    //Add discount button, only visible to employees
    @if (User.IsInRole("northwind-employee"))
    {
        <div class="modal fade" id="addDiscountModal" tabindex="-1" aria-labelledby="addDiscountLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="addDiscountLabel">Create New Discount</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <form asp-action="AddDiscount" method="post">

                        <div class="modal-body">

                            <div class="mb-3">
                                <label class="form-label">Discount Title</label>
                                <input name="Title" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea name="Description" class="form-control" rows="3" required></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Product</label>
                                <select name="ProductId" class="form-select" required>
                                    @foreach (var p in ViewBag.Products)
                                    {
                                        <option value="@p.ProductId">@p.ProductName</option>
                                    }
                                </select>
                            </div>


                            </div>

                            <div class="mb-3">
                                <label class="form-label">End Date</label>
                                <input type="date" name="EndTime" class="form-control" required />
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Create Discount</button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    }
    </div>
<!-- toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="toast-header">
      <strong class="me-auto" id="product">Product</strong>
      <small class="text-body-secondary" id="title">just now</small>
      <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
    <div class="toast-body">
      Discount Code: <span id="code">Code</span>
    </div>
  </div>
</div>
<script type="text/javascript" src="~/discount.js"></script>
